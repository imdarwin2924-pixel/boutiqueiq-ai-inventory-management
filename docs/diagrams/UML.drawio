        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\ndirection TB\n\nclass Role {\n  +int roleId\n  +String roleName\n  +String description\n  +createUser()\n  +updateRole()\n  +getUsers()\n}\n\nclass User {\n  +int userId\n  +String fullName\n  +String email\n  +String passwordHash\n  +String phone\n  +String status\n  +login()\n  +logout()\n  +authenticate()\n  +updateProfile()\n  +changePassword()\n}\n\nclass Category {\n  +int categoryId\n  +String categoryName\n  +String description\n  +createCategory()\n  +updateCategory()\n  +deleteCategory()\n  +getProducts()\n}\n\nclass Product {\n  +int productId\n  +String productName\n  +String sku\n  +String brand\n  +String size\n  +String color\n  +Decimal purchasePrice\n  +Decimal sellingPrice\n  +int stockQuantity\n  +createProduct()\n  +updateProduct()\n  +deleteProduct()\n  +getStock()\n  +updateStock()\n}\n\nclass Inventory {\n  +int inventoryId\n  +int quantity\n  +int minimumStock\n  +String location\n  +DateTime lastUpdated\n  +addStock()\n  +removeStock()\n  +checkStock()\n  +checkLowStock()\n}\n\nclass StockTransaction {\n  +int transactionId\n  +String transactionType\n  +int quantity\n  +DateTime transactionDate\n  +String reason\n  +recordTransaction()\n  +validateQuantity()\n  +updateInventory()\n}\n\nclass AIPrediction {\n  +int predictionId\n  +Decimal predictedDemand\n  +Decimal confidenceScore\n  +DateTime predictionDate\n  +int recommendedStock\n  +predictDemand()\n  +calculateConfidence()\n  +generateRecommendation()\n}\n\nclass Customer {\n  +int customerId\n  +String customerName\n  +String phone\n  +String email\n  +String address\n  +createCustomer()\n  +updateCustomer()\n  +deleteCustomer()\n  +getSalesHistory()\n}\n\nclass Sale {\n  +int saleId\n  +String invoiceNumber\n  +DateTime saleDate\n  +Decimal totalAmount\n  +String paymentMethod\n  +createSale()\n  +calculateTotal()\n  +completeSale()\n  +cancelSale()\n}\n\nclass SaleItem {\n  +int saleItemId\n  +int quantity\n  +Decimal unitPrice\n  +Decimal subtotal\n  +calculateSubtotal()\n  +updateQuantity()\n}\n\nclass Supplier {\n  +int supplierId\n  +String supplierName\n  +String contactPerson\n  +String phone\n  +String email\n  +String address\n  +createSupplier()\n  +updateSupplier()\n  +deleteSupplier()\n  +getPurchaseOrders()\n}\n\nclass PurchaseOrder {\n  +int purchaseOrderId\n  +String orderNumber\n  +DateTime orderDate\n  +Decimal totalAmount\n  +String status\n  +createPurchaseOrder()\n  +calculateTotal()\n  +approveOrder()\n  +receiveOrder()\n  +cancelOrder()\n}\n\nclass PurchaseItem {\n  +int purchaseItemId\n  +int quantity\n  +Decimal unitPrice\n  +Decimal subtotal\n  +calculateSubtotal()\n  +updateQuantity()\n}\n\nclass Notification {\n  +int notificationId\n  +String title\n  +String message\n  +String notificationType\n  +Boolean isRead\n  +DateTime createdAt\n  +createNotification()\n  +markAsRead()\n  +sendNotification()\n}\n\nRole \&quot;1\&quot; --&gt; \&quot;0..*\&quot; User\nCategory \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Product\nProduct \&quot;1\&quot; --&gt; \&quot;1\&quot; Inventory\nProduct \&quot;1\&quot; --&gt; \&quot;0..*\&quot; StockTransaction\nProduct \&quot;1\&quot; --&gt; \&quot;0..*\&quot; AIPrediction\nSupplier \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PurchaseOrder\nUser \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PurchaseOrder\nPurchaseOrder \&quot;1\&quot; *-- \&quot;1..*\&quot; PurchaseItem\nProduct \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PurchaseItem\nCustomer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Sale\nUser \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Sale\nSale \&quot;1\&quot; *-- \&quot;1..*\&quot; SaleItem\nProduct \&quot;1\&quot; --&gt; \&quot;0..*\&quot; SaleItem\nUser \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Notification\n\n\nclass Role,User identity\nclass Category,Product,Inventory,StockTransaction,AIPrediction productDomain\nclass Customer,Sale,SaleItem salesDomain\nclass Supplier,PurchaseOrder,PurchaseItem purchaseDomain\nclass Notification systemDomain&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TL4Um0A-fTOQgc6SeSwD-1">
